# Chave secreta (service_role) — NUNCA exponha ao navegador. Necessária apenas
# para a rotina periódica de verificação de fontes (cron) e scripts de admin.
# Obtenha em: Supabase Dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API Anthropic (Claude) — usada no servidor para gerar questões
# inéditas, diagnósticos e resumos. Sem ela, os recursos de IA ficam desativados
# e o restante do sistema (import manual, banco de questões, estatísticas,
# PDFs, revisão espaçada) continua funcionando normalmente.
ANTHROPIC_API_KEY=

# Segredo usado para assinar o token do cron de verificação de fontes
# (ver src/app/api/cron/verificar-fontes/route.ts).
CRON_SECRET=troque-este-valor
